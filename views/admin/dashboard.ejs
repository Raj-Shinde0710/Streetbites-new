<%- include('layout_header') %>

<!-- Statistics Grid: 8 Dynamic KPI Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <!-- 1. Total Donations -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Donations</p>
            <h3 class="text-2xl font-bold text-slate-900 mt-1"><%= stats.totalDonations %></h3>
            <p class="text-[11px] text-slate-500 mt-1">Combined across all models</p>
        </div>
        <div class="h-12 w-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
        </div>
    </div>

    <!-- 2. Food Donations -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Food Donations</p>
            <h3 class="text-2xl font-bold text-emerald-600 mt-1"><%= stats.totalFood %></h3>
            <p class="text-[11px] text-slate-500 mt-1">Meals & prepared dishes</p>
        </div>
        <div class="h-12 w-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        </div>
    </div>

    <!-- 3. Clothes Donations -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Clothes Donations</p>
            <h3 class="text-2xl font-bold text-purple-600 mt-1"><%= stats.totalClothes %></h3>
            <p class="text-[11px] text-slate-500 mt-1">Garments & blankets</p>
        </div>
        <div class="h-12 w-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        </div>
    </div>

    <!-- 4. Money Donations -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Money Donations</p>
            <h3 class="text-2xl font-bold text-amber-600 mt-1"><%= stats.totalMoney %></h3>
            <p class="text-[11px] text-slate-500 mt-1">Razorpay transactions</p>
        </div>
        <div class="h-12 w-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
    </div>

    <!-- 5. Individual Donations -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Individual Donors</p>
            <h3 class="text-2xl font-bold text-slate-900 mt-1"><%= stats.totalIndividual %></h3>
            <p class="text-[11px] text-slate-500 mt-1">Personal contributions</p>
        </div>
        <div class="h-12 w-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        </div>
    </div>

    <!-- 6. Organization Donations -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Organization Donors</p>
            <h3 class="text-2xl font-bold text-slate-900 mt-1"><%= stats.totalOrganization %></h3>
            <p class="text-[11px] text-slate-500 mt-1">NGOs, restaurants, CSR</p>
        </div>
        <div class="h-12 w-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
        </div>
    </div>

    <!-- 7. Total Money Collected -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Funds Collected</p>
            <h3 class="text-2xl font-bold text-green-700 mt-1">₹<%= stats.totalMoneyCollected.toLocaleString("en-IN") %></h3>
            <p class="text-[11px] text-emerald-600 font-medium mt-1">Verified payments only</p>
        </div>
        <div class="h-12 w-12 rounded-xl bg-green-50 text-green-600 flex items-center justify-center">
            <span class="text-xl font-bold">₹</span>
        </div>
    </div>

    <!-- 8. Total Registered Users -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Registered Users</p>
            <h3 class="text-2xl font-bold text-indigo-600 mt-1"><%= stats.totalUsersCount %></h3>
            <p class="text-[11px] text-slate-500 mt-1">Community members</p>
        </div>
        <div class="h-12 w-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        </div>
    </div>
</div>

<!-- Quick Category Navigation Strip -->
<div class="bg-indigo-900/5 rounded-2xl p-4 mb-8 border border-indigo-100 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center space-x-2 text-xs font-semibold text-slate-700">
        <span class="text-slate-400">Quick Filters:</span>
        <a href="/admin/donations" class="bg-white hover:bg-slate-100 px-3 py-1.5 rounded-lg border text-slate-700 shadow-sm transition">All (<%= stats.totalDonations %>)</a>
        <a href="/admin/donations?category=food" class="bg-white hover:bg-emerald-50 px-3 py-1.5 rounded-lg border text-emerald-700 shadow-sm transition">🍲 Food (<%= stats.totalFood %>)</a>
        <a href="/admin/donations?category=clothes" class="bg-white hover:bg-purple-50 px-3 py-1.5 rounded-lg border text-purple-700 shadow-sm transition">👕 Clothes (<%= stats.totalClothes %>)</a>
        <a href="/admin/donations?category=money" class="bg-white hover:bg-amber-50 px-3 py-1.5 rounded-lg border text-amber-700 shadow-sm transition">💰 Money (<%= stats.totalMoney %>)</a>
    </div>

    <a href="/admin/donations" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition flex items-center space-x-1">
        <span>View Full Database</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    </a>
</div>

<!-- Recent Donations Table -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
        <div>
            <h2 class="text-base font-bold text-slate-900">Recent Donations</h2>
            <p class="text-xs text-slate-500">Latest entries submitted across all 6 models</p>
        </div>
        <a href="/admin/donations" class="text-xs font-semibold text-indigo-600 hover:underline">
            View All &rarr;
        </a>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-slate-400 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                <tr>
                    <th class="py-3 px-6">Donor / Organization</th>
                    <th class="py-3 px-6">Category</th>
                    <th class="py-3 px-6">Details / Summary</th>
                    <th class="py-3 px-6">Submitted</th>
                    <th class="py-3 px-6">Status</th>
                    <th class="py-3 px-6 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <% if (recentDonations.length === 0) { %>
                    <tr>
                        <td colspan="6" class="py-8 text-center text-slate-400 text-xs">No donations found in database.</td>
                    </tr>
                <% } else { %>
                    <% recentDonations.forEach(donation => { %>
                        <tr class="hover:bg-slate-50/70 transition">
                            <!-- Donor Info -->
                            <td class="py-4 px-6">
                                <div class="font-semibold text-slate-900"><%= donation.donorName %></div>
                                <div class="text-xs text-slate-400"><%= donation.email || donation.mobile || 'No contact' %></div>
                            </td>

                            <!-- Category & Type -->
                            <td class="py-4 px-6">
                                <% if (donation.category === 'food') { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                                        🍲 Food
                                    </span>
                                <% } else if (donation.category === 'clothes') { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-800">
                                        👕 Clothes
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
                                        💰 Money
                                    </span>
                                <% } %>
                                <span class="text-[11px] text-slate-400 block mt-0.5 capitalize"><%= donation.donorType %></span>
                            </td>

                            <!-- Summary -->
                            <td class="py-4 px-6 text-xs text-slate-600 max-w-xs truncate">
                                <%= donation.summary %>
                            </td>

                            <!-- Date -->
                            <td class="py-4 px-6 text-xs text-slate-500 whitespace-nowrap">
                                <%= new Date(donation.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                            </td>

                            <!-- Status -->
                            <td class="py-4 px-6">
                                <% if (donation.status === 'Completed') { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">Completed</span>
                                <% } else if (donation.status === 'Accepted' || donation.status === 'Pickup Scheduled') { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800"><%= donation.status %></span>
                                <% } else if (donation.status === 'Rejected') { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-800">Rejected</span>
                                <% } else { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">Pending</span>
                                <% } %>
                            </td>

                            <!-- Action -->
                            <td class="py-4 px-6 text-right whitespace-nowrap">
                                <a href="/admin/donations/<%= donation.modelType %>/<%= donation._id %>" 
                                   class="inline-flex items-center space-x-1 text-xs font-semibold text-indigo-600 hover:text-indigo-900 bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-lg transition">
                                    <span>Details</span>
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('layout_footer') %>

