<%- include('layout_header') %>

<!-- Search Toolbar -->
<div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm mb-6">
    <form action="/admin/users" method="GET" class="flex flex-col sm:flex-row gap-3">
        <div class="flex-grow relative">
            <input type="text" name="search" 
                   value="<%= typeof search !== 'undefined' ? search : '' %>"
                   placeholder="Search by full name, username, email, or mobile..."
                   class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <svg class="w-5 h-5 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>

        <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-semibold text-xs transition shadow-sm">
            Search Users
        </button>
        <a href="/admin/users" class="bg-slate-100 hover:bg-slate-200 text-slate-600 px-4 py-2.5 rounded-xl font-semibold text-xs transition text-center">
            Reset
        </a>
    </form>
</div>

<!-- Users Table -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
        <div>
            <h2 class="text-base font-bold text-slate-900">Registered Accounts</h2>
            <p class="text-xs text-slate-500">Showing <%= users.length %> user(s) on page <%= pagination.currentPage %> of <%= pagination.totalPages %></p>
        </div>
        <span class="text-xs font-semibold bg-indigo-50 text-indigo-700 px-3 py-1 rounded-full">
            <%= pagination.totalCount %> Total Users
        </span>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-slate-400 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                <tr>
                    <th class="py-3 px-6">User</th>
                    <th class="py-3 px-6">Username</th>
                    <th class="py-3 px-6">Email Address</th>
                    <th class="py-3 px-6">Mobile</th>
                    <th class="py-3 px-6">Role</th>
                    <th class="py-3 px-6">Registered</th>
                    <th class="py-3 px-6 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <% if (users.length === 0) { %>
                    <tr>
                        <td colspan="7" class="py-12 text-center text-slate-400 text-xs">
                            No registered users found.
                        </td>
                    </tr>
                <% } else { %>
                    <% users.forEach(user => { %>
                        <tr class="hover:bg-slate-50/70 transition">
                            <!-- Name with Avatar -->
                            <td class="py-4 px-6">
                                <div class="flex items-center space-x-3">
                                    <div class="h-8 w-8 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-xs">
                                        <%= user.fullName.charAt(0).toUpperCase() %>
                                    </div>
                                    <span class="font-bold text-slate-900"><%= user.fullName %></span>
                                </div>
                            </td>

                            <!-- Username -->
                            <td class="py-4 px-6 text-xs font-mono text-slate-600">
                                @<%= user.username %>
                            </td>

                            <!-- Email -->
                            <td class="py-4 px-6 text-xs text-slate-700">
                                <%= user.email %>
                            </td>

                            <!-- Mobile -->
                            <td class="py-4 px-6 text-xs text-slate-500">
                                <%= user.mobile || '—' %>
                            </td>

                            <!-- Role -->
                            <td class="py-4 px-6">
                                <% if (user.role === 'admin') { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-indigo-100 text-indigo-800">
                                        Admin
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-700">
                                        Donor
                                    </span>
                                <% } %>
                            </td>

                            <!-- Registration Date -->
                            <td class="py-4 px-6 text-xs text-slate-500 whitespace-nowrap">
                                <%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                            </td>

                            <!-- Actions -->
                            <td class="py-4 px-6 text-right whitespace-nowrap">
                                <a href="/admin/users/<%= user._id %>" 
                                   class="inline-flex items-center space-x-1 text-xs font-semibold text-indigo-600 hover:text-indigo-900 bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-lg transition">
                                    <span>View Activity</span>
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <% if (pagination.totalPages > 1) { %>
        <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <div>
                Showing <%= ((pagination.currentPage - 1) * pagination.limit) + 1 %> to <%= Math.min(pagination.currentPage * pagination.limit, pagination.totalCount) %> of <%= pagination.totalCount %> users
            </div>
            <div class="flex items-center space-x-1">
                <% if (pagination.hasPrev) { %>
                    <a href="/admin/users?search=<%= search %>&page=<%= pagination.currentPage - 1 %>"
                       class="px-3 py-1.5 border border-slate-200 rounded-lg hover:bg-slate-50 transition">Previous</a>
                <% } %>
                <span class="px-3 py-1.5 bg-indigo-600 text-white rounded-lg font-bold"><%= pagination.currentPage %></span>
                <% if (pagination.hasNext) { %>
                    <a href="/admin/users?search=<%= search %>&page=<%= pagination.currentPage + 1 %>"
                       class="px-3 py-1.5 border border-slate-200 rounded-lg hover:bg-slate-50 transition">Next</a>
                <% } %>
            </div>
        </div>
    <% } %>
</div>

<%- include('layout_footer') %>

