<%- include('layout_header') %>

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Top Action Bar -->
    <div class="flex items-center justify-between">
        <a href="/admin/users" class="inline-flex items-center space-x-1.5 text-xs font-semibold text-slate-600 hover:text-indigo-600 transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            <span>Back to Users List</span>
        </a>

        <div class="flex items-center space-x-2">
            <span class="text-xs text-slate-400">User ID:</span>
            <span class="text-xs font-mono bg-slate-100 text-slate-700 px-2 py-1 rounded"><%= user._id %></span>
        </div>
    </div>

    <!-- User Profile Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 md:p-8">
        <div class="flex items-center space-x-5 mb-6">
            <div class="h-16 w-16 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-2xl shadow-inner">
                <%= user.fullName.charAt(0).toUpperCase() %>
            </div>
            <div>
                <div class="flex items-center space-x-2">
                    <h2 class="text-2xl font-bold text-slate-900"><%= user.fullName %></h2>
                    <% if (user.role === 'admin') { %>
                        <span class="bg-indigo-100 text-indigo-800 text-xs px-2.5 py-0.5 rounded-full font-bold">Admin</span>
                    <% } else { %>
                        <span class="bg-slate-100 text-slate-700 text-xs px-2.5 py-0.5 rounded-full font-medium">Donor</span>
                    <% } %>
                </div>
                <p class="text-xs text-slate-500 mt-0.5">@<%= user.username %> &bull; <%= user.email %></p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-slate-100 text-xs">
            <div>
                <span class="text-slate-400 font-semibold block uppercase">Mobile Number</span>
                <span class="font-medium text-slate-800"><%= user.mobile || 'Not provided' %></span>
            </div>
            <div>
                <span class="text-slate-400 font-semibold block uppercase">Registered On</span>
                <span class="font-medium text-slate-800"><%= new Date(user.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
            </div>
            <div>
                <span class="text-slate-400 font-semibold block uppercase">Account Status</span>
                <span class="inline-block mt-0.5 px-2 py-0.5 rounded text-[11px] font-semibold <%= user.status === 'active' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                    <%= user.status ? user.status.toUpperCase() : 'ACTIVE' %>
                </span>
            </div>
        </div>
    </div>

    <!-- Associated Donations Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
            <div>
                <h3 class="text-base font-bold text-slate-900">Donations by this User</h3>
                <p class="text-xs text-slate-500">Matched by user account and registered email address</p>
            </div>
            <span class="text-xs font-semibold bg-indigo-50 text-indigo-700 px-3 py-1 rounded-full">
                <%= donations.length %> Record(s)
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-slate-400 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                    <tr>
                        <th class="py-3 px-6">Category</th>
                        <th class="py-3 px-6">Summary / Content</th>
                        <th class="py-3 px-6">Date</th>
                        <th class="py-3 px-6">Status</th>
                        <th class="py-3 px-6 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% if (donations.length === 0) { %>
                        <tr>
                            <td colspan="5" class="py-8 text-center text-slate-400 text-xs">
                                No donations linked to this user yet.
                            </td>
                        </tr>
                    <% } else { %>
                        <% donations.forEach(item => { %>
                            <tr class="hover:bg-slate-50/70 transition">
                                <td class="py-3.5 px-6">
                                    <% if (item.category === 'food') { %>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">🍲 Food</span>
                                    <% } else if (item.category === 'clothes') { %>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-800">👕 Clothes</span>
                                    <% } else { %>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">💰 Money</span>
                                    <% } %>
                                </td>
                                <td class="py-3.5 px-6 text-xs text-slate-800 font-medium">
                                    <%= item.summary %>
                                </td>
                                <td class="py-3.5 px-6 text-xs text-slate-500 whitespace-nowrap">
                                    <%= new Date(item.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                </td>
                                <td class="py-3.5 px-6">
                                    <% if (item.status === 'Completed') { %>
                                        <span class="inline-block bg-emerald-100 text-emerald-800 text-xs px-2.5 py-0.5 rounded-full font-medium">Completed</span>
                                    <% } else if (item.status === 'Accepted' || item.status === 'Pickup Scheduled') { %>
                                        <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2.5 py-0.5 rounded-full font-medium"><%= item.status %></span>
                                    <% } else if (item.status === 'Rejected') { %>
                                        <span class="inline-block bg-rose-100 text-rose-800 text-xs px-2.5 py-0.5 rounded-full font-medium">Rejected</span>
                                    <% } else { %>
                                        <span class="inline-block bg-amber-100 text-amber-800 text-xs px-2.5 py-0.5 rounded-full font-medium">Pending</span>
                                    <% } %>
                                </td>
                                <td class="py-3.5 px-6 text-right whitespace-nowrap">
                                    <a href="/admin/donations/<%= item.modelType %>/<%= item._id %>" class="text-xs font-semibold text-indigo-600 hover:underline">
                                        View Details &rarr;
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('layout_footer') %>

