<%- include('layout_header') %>

<!-- Filter & Search Toolbar -->
<div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm mb-6">
    <form action="/admin/donations" method="GET" class="space-y-4">
        <!-- Search and Top Controls -->
        <div class="flex flex-col md:flex-row gap-3">
            <div class="flex-grow relative">
                <input type="text" name="search" 
                       value="<%= filters.search || '' %>"
                       placeholder="Search by donor name, email, phone, or items..."
                       class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <svg class="w-5 h-5 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>

            <!-- Category Tabs -->
            <div class="flex items-center space-x-1 bg-slate-100 p-1 rounded-xl">
                <a href="/admin/donations?category=all&donorType=<%= filters.donorType %>&status=<%= filters.status %>&search=<%= filters.search %>&sort=<%= filters.sort %>" 
                   class="px-3 py-1.5 rounded-lg text-xs font-semibold transition <%= filters.category === 'all' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-600 hover:text-slate-900' %>">All</a>
                <a href="/admin/donations?category=food&donorType=<%= filters.donorType %>&status=<%= filters.status %>&search=<%= filters.search %>&sort=<%= filters.sort %>" 
                   class="px-3 py-1.5 rounded-lg text-xs font-semibold transition <%= filters.category === 'food' ? 'bg-emerald-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900' %>">🍲 Food</a>
                <a href="/admin/donations?category=clothes&donorType=<%= filters.donorType %>&status=<%= filters.status %>&search=<%= filters.search %>&sort=<%= filters.sort %>" 
                   class="px-3 py-1.5 rounded-lg text-xs font-semibold transition <%= filters.category === 'clothes' ? 'bg-purple-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900' %>">👕 Clothes</a>
                <a href="/admin/donations?category=money&donorType=<%= filters.donorType %>&status=<%= filters.status %>&search=<%= filters.search %>&sort=<%= filters.sort %>" 
                   class="px-3 py-1.5 rounded-lg text-xs font-semibold transition <%= filters.category === 'money' ? 'bg-amber-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900' %>">💰 Money</a>
            </div>

            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-semibold text-xs transition shadow-sm">
                Filter
            </button>
            <a href="/admin/donations" class="bg-slate-100 hover:bg-slate-200 text-slate-600 px-4 py-2.5 rounded-xl font-semibold text-xs transition text-center">
                Reset
            </a>
        </div>

        <input type="hidden" name="category" value="<%= filters.category %>">

        <!-- Additional Filters -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3 border-t border-slate-100 text-xs">
            <!-- Donor Type -->
            <div>
                <label class="block text-slate-400 font-semibold mb-1">Donor Type</label>
                <select name="donorType" onchange="this.form.submit()" class="w-full border border-slate-300 rounded-lg p-2 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="all" <%= filters.donorType === 'all' ? 'selected' : '' %>>All Donor Types</option>
                    <option value="individual" <%= filters.donorType === 'individual' ? 'selected' : '' %>>Individual</option>
                    <option value="organization" <%= filters.donorType === 'organization' ? 'selected' : '' %>>Organization</option>
                </select>
            </div>

            <!-- Status -->
            <div>
                <label class="block text-slate-400 font-semibold mb-1">Status</label>
                <select name="status" onchange="this.form.submit()" class="w-full border border-slate-300 rounded-lg p-2 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
                    <option value="Pending" <%= filters.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                    <option value="Accepted" <%= filters.status === 'Accepted' ? 'selected' : '' %>>Accepted</option>
                    <option value="Pickup Scheduled" <%= filters.status === 'Pickup Scheduled' ? 'selected' : '' %>>Pickup Scheduled</option>
                    <option value="Completed" <%= filters.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                    <option value="Rejected" <%= filters.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                </select>
            </div>

            <!-- Sort -->
            <div>
                <label class="block text-slate-400 font-semibold mb-1">Sort Order</label>
                <select name="sort" onchange="this.form.submit()" class="w-full border border-slate-300 rounded-lg p-2 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
                    <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                </select>
            </div>
        </div>
    </form>
</div>

<!-- Unified Donations Table -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
        <div>
            <h2 class="text-base font-bold text-slate-900">Donations List</h2>
            <p class="text-xs text-slate-500">Showing page <%= pagination.currentPage %> of <%= pagination.totalPages %> (<%= pagination.totalCount %> records)</p>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-slate-400 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                <tr>
                    <th class="py-3 px-6">Donor / Organization</th>
                    <th class="py-3 px-6">Category</th>
                    <th class="py-3 px-6">Summary / Content</th>
                    <th class="py-3 px-6">Date</th>
                    <th class="py-3 px-6">Status Update</th>
                    <th class="py-3 px-6 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <% if (donations.length === 0) { %>
                    <tr>
                        <td colspan="6" class="py-12 text-center text-slate-400 text-xs">
                            No donations match the selected filter criteria.
                        </td>
                    </tr>
                <% } else { %>
                    <% donations.forEach(item => { %>
                        <tr class="hover:bg-slate-50/70 transition">
                            <!-- Donor Info -->
                            <td class="py-4 px-6">
                                <div class="font-bold text-slate-900"><%= item.donorName %></div>
                                <div class="text-xs text-slate-500"><%= item.email || 'No email' %></div>
                                <div class="text-xs text-slate-400"><%= item.mobile || 'No phone' %></div>
                            </td>

                            <!-- Category & Type -->
                            <td class="py-4 px-6">
                                <% if (item.category === 'food') { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                                        🍲 Food
                                    </span>
                                <% } else if (item.category === 'clothes') { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-800">
                                        👕 Clothes
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
                                        💰 Money
                                    </span>
                                <% } %>
                                <span class="text-[11px] text-slate-400 block mt-1 capitalize"><%= item.donorType %></span>
                            </td>

                            <!-- Summary -->
                            <td class="py-4 px-6 text-xs text-slate-700 max-w-xs">
                                <div class="font-medium"><%= item.summary %></div>
                                <% if (item.category === 'money' && item.raw.razorpayPaymentId) { %>
                                    <span class="text-[10px] text-slate-400 font-mono block mt-0.5 truncate">PayID: <%= item.raw.razorpayPaymentId %></span>
                                <% } %>
                            </td>

                            <!-- Date -->
                            <td class="py-4 px-6 text-xs text-slate-500 whitespace-nowrap">
                                <%= new Date(item.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                            </td>

                            <!-- Status (Quick Update Form) -->
                            <td class="py-4 px-6">
                                <form action="/admin/donations/<%= item.modelType %>/<%= item._id %>/status" method="POST" class="inline-flex items-center space-x-1.5">
                                    <select name="status" onchange="this.form.submit()" 
                                            class="text-xs rounded-lg border border-slate-300 py-1 px-2 font-medium focus:ring-1 focus:ring-indigo-500
                                                   <%= item.status === 'Completed' ? 'bg-emerald-50 text-emerald-800 border-emerald-200' :
                                                       item.status === 'Accepted' || item.status === 'Pickup Scheduled' ? 'bg-blue-50 text-blue-800 border-blue-200' :
                                                       item.status === 'Rejected' ? 'bg-rose-50 text-rose-800 border-rose-200' :
                                                       'bg-amber-50 text-amber-800 border-amber-200' %>">
                                        <option value="Pending" <%= item.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                        <option value="Accepted" <%= item.status === 'Accepted' ? 'selected' : '' %>>Accepted</option>
                                        <option value="Pickup Scheduled" <%= item.status === 'Pickup Scheduled' ? 'selected' : '' %>>Pickup Scheduled</option>
                                        <option value="Completed" <%= item.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                                        <option value="Rejected" <%= item.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                                    </select>
                                </form>
                            </td>

                            <!-- View Details -->
                            <td class="py-4 px-6 text-right whitespace-nowrap">
                                <a href="/admin/donations/<%= item.modelType %>/<%= item._id %>" 
                                   class="inline-flex items-center space-x-1 text-xs font-semibold text-indigo-600 hover:text-indigo-900 bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-lg transition">
                                    <span>View Details</span>
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <% if (pagination.totalPages > 1) { %>
        <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <div>
                Showing <%= ((pagination.currentPage - 1) * pagination.limit) + 1 %> to <%= Math.min(pagination.currentPage * pagination.limit, pagination.totalCount) %> of <%= pagination.totalCount %> donations
            </div>
            <div class="flex items-center space-x-1">
                <% if (pagination.hasPrev) { %>
                    <a href="/admin/donations?category=<%= filters.category %>&donorType=<%= filters.donorType %>&status=<%= filters.status %>&search=<%= filters.search %>&sort=<%= filters.sort %>&page=<%= pagination.currentPage - 1 %>"
                       class="px-3 py-1.5 border border-slate-200 rounded-lg hover:bg-slate-50 transition">Previous</a>
                <% } %>

                <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                    <% if (p === pagination.currentPage) { %>
                        <span class="px-3 py-1.5 bg-indigo-600 text-white rounded-lg font-bold"><%= p %></span>
                    <% } else if (p === 1 || p === pagination.totalPages || (p >= pagination.currentPage - 1 && p <= pagination.currentPage + 1)) { %>
                        <a href="/admin/donations?category=<%= filters.category %>&donorType=<%= filters.donorType %>&status=<%= filters.status %>&search=<%= filters.search %>&sort=<%= filters.sort %>&page=<%= p %>"
                           class="px-3 py-1.5 border border-slate-200 rounded-lg hover:bg-slate-50 transition"><%= p %></a>
                    <% } else if (p === pagination.currentPage - 2 || p === pagination.currentPage + 2) { %>
                        <span class="px-2 py-1.5 text-slate-400">...</span>
                    <% } %>
                <% } %>

                <% if (pagination.hasNext) { %>
                    <a href="/admin/donations?category=<%= filters.category %>&donorType=<%= filters.donorType %>&status=<%= filters.status %>&search=<%= filters.search %>&sort=<%= filters.sort %>&page=<%= pagination.currentPage + 1 %>"
                       class="px-3 py-1.5 border border-slate-200 rounded-lg hover:bg-slate-50 transition">Next</a>
                <% } %>
            </div>
        </div>
    <% } %>
</div>

<%- include('layout_footer') %>

