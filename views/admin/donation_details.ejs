<%- include('layout_header') %>

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Top Action Bar -->
    <div class="flex items-center justify-between">
        <a href="/admin/donations" class="inline-flex items-center space-x-1.5 text-xs font-semibold text-slate-600 hover:text-indigo-600 transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            <span>Back to All Donations</span>
        </a>

        <div class="flex items-center space-x-2">
            <span class="text-xs text-slate-400">Record ID:</span>
            <span class="text-xs font-mono bg-slate-100 text-slate-700 px-2 py-1 rounded"><%= donation._id %></span>
        </div>
    </div>

    <!-- Main Detail Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <!-- Card Header -->
        <div class="p-6 md:p-8 bg-slate-900 text-white flex flex-col sm:flex-row justify-between sm:items-center gap-4">
            <div>
                <div class="flex items-center space-x-2 mb-2">
                    <% if (donation.category === 'food') { %>
                        <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs px-3 py-1 rounded-full font-semibold">🍲 Food Donation</span>
                    <% } else if (donation.category === 'clothes') { %>
                        <span class="bg-purple-500/20 text-purple-300 border border-purple-500/30 text-xs px-3 py-1 rounded-full font-semibold">👕 Clothes Donation</span>
                    <% } else { %>
                        <span class="bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs px-3 py-1 rounded-full font-semibold">💰 Money Donation</span>
                    <% } %>

                    <span class="bg-slate-800 text-slate-300 text-xs px-2.5 py-0.5 rounded-full capitalize"><%= donation.donorType %></span>
                </div>
                <h2 class="text-2xl font-bold"><%= donation.donorName %></h2>
                <p class="text-xs text-slate-400 mt-1">Submitted on <%= new Date(donation.createdAt).toLocaleString('en-US', { dateStyle: 'full', timeStyle: 'short' }) %></p>
            </div>

            <!-- Current Status Badge -->
            <div class="text-right sm:text-right">
                <span class="text-[11px] text-slate-400 block mb-1">Current Status:</span>
                <% if (donation.status === 'Completed') { %>
                    <span class="inline-block bg-emerald-600 text-white text-xs px-3 py-1.5 rounded-xl font-bold shadow">Completed</span>
                <% } else if (donation.status === 'Accepted' || donation.status === 'Pickup Scheduled') { %>
                    <span class="inline-block bg-blue-600 text-white text-xs px-3 py-1.5 rounded-xl font-bold shadow"><%= donation.status %></span>
                <% } else if (donation.status === 'Rejected') { %>
                    <span class="inline-block bg-rose-600 text-white text-xs px-3 py-1.5 rounded-xl font-bold shadow">Rejected</span>
                <% } else { %>
                    <span class="inline-block bg-amber-500 text-white text-xs px-3 py-1.5 rounded-xl font-bold shadow">Pending</span>
                <% } %>
            </div>
        </div>

        <div class="p-6 md:p-8 space-y-8">
            <!-- Donor Contact Info -->
            <div>
                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4">Donor Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-slate-50 p-4 rounded-xl border border-slate-100 text-xs">
                    <div>
                        <span class="text-slate-400 font-semibold block">Donor Name:</span>
                        <span class="font-bold text-slate-800 text-sm"><%= donation.donorName %></span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-semibold block">Email Address:</span>
                        <span class="font-medium text-slate-800"><%= donation.email || 'N/A' %></span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-semibold block">Phone Number:</span>
                        <span class="font-medium text-slate-800"><%= donation.mobile || 'N/A' %></span>
                    </div>
                    <% if (donation.address) { %>
                        <div class="md:col-span-2">
                            <span class="text-slate-400 font-semibold block">Pickup Address:</span>
                            <span class="font-medium text-slate-800"><%= donation.address %></span>
                        </div>
                    <% } %>
                    <% if (donation.raw.pickupMethod) { %>
                        <div>
                            <span class="text-slate-400 font-semibold block">Pickup Method:</span>
                            <span class="font-semibold text-slate-800 capitalize"><%= donation.raw.pickupMethod === 'self' ? 'Donor will deliver' : 'Volunteer pickup' %></span>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Specific Category Details -->
            <% if (donation.category === 'food') { %>
                <!-- Food Donation Details -->
                <div>
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-3">Food Items & Freshness</h3>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4 text-xs">
                        <div class="bg-emerald-50/60 p-3 rounded-lg border border-emerald-100">
                            <span class="text-emerald-700 font-semibold block">Cooking Date:</span>
                            <span class="text-emerald-950 font-medium">
                                <%= donation.raw.cookingDate ? new Date(donation.raw.cookingDate).toLocaleDateString('en-US', { dateStyle: 'medium' }) : 'Not specified' %>
                            </span>
                        </div>
                        <div class="bg-amber-50/60 p-3 rounded-lg border border-amber-100">
                            <span class="text-amber-700 font-semibold block">Use Before Date:</span>
                            <span class="text-amber-950 font-medium">
                                <%= donation.raw.useBeforeDate ? new Date(donation.raw.useBeforeDate).toLocaleDateString('en-US', { dateStyle: 'medium' }) : 'Not specified' %>
                            </span>
                        </div>
                    </div>

                    <div class="border border-slate-200 rounded-xl overflow-hidden">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-100 text-slate-600 font-semibold uppercase">
                                <tr>
                                    <th class="py-2.5 px-4">Item Name</th>
                                    <th class="py-2.5 px-4">Quantity</th>
                                    <th class="py-2.5 px-4">Storage Instructions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (donation.raw.foodItems && donation.raw.foodItems.length > 0) { %>
                                    <% donation.raw.foodItems.forEach(item => { %>
                                        <tr>
                                            <td class="py-2.5 px-4 font-semibold text-slate-800"><%= item.foodName %></td>
                                            <td class="py-2.5 px-4"><%= item.quantity %></td>
                                            <td class="py-2.5 px-4 text-slate-500"><%= item.storage || 'Room Temp' %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="3" class="py-4 px-4 text-center text-slate-400">Meal details not itemized.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            <% } else if (donation.category === 'clothes') { %>
                <!-- Clothes Donation Details -->
                <div>
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-3">Clothing Items</h3>
                    <div class="border border-slate-200 rounded-xl overflow-hidden">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-100 text-slate-600 font-semibold uppercase">
                                <tr>
                                    <th class="py-2.5 px-4">Clothing Type</th>
                                    <th class="py-2.5 px-4">Size</th>
                                    <th class="py-2.5 px-4">Quantity</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (donation.raw.clothesItems && donation.raw.clothesItems.length > 0) { %>
                                    <% donation.raw.clothesItems.forEach(item => { %>
                                        <tr>
                                            <td class="py-2.5 px-4 font-semibold text-slate-800"><%= item.clothingType %></td>
                                            <td class="py-2.5 px-4"><%= item.size || 'Mixed' %></td>
                                            <td class="py-2.5 px-4 text-slate-600 font-medium"><%= item.quantity %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="3" class="py-4 px-4 text-center text-slate-400">No clothing items specified.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            <% } else if (donation.category === 'money') { %>
                <!-- Money Donation Details -->
                <div>
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-3">Payment & Transaction Details</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-amber-50/50 p-5 rounded-xl border border-amber-100 text-xs">
                        <div>
                            <span class="text-amber-800 font-semibold block">Donated Amount:</span>
                            <span class="text-2xl font-bold text-emerald-700">₹<%= Number(donation.raw.amount).toLocaleString('en-IN') %></span>
                        </div>
                        <div>
                            <span class="text-amber-800 font-semibold block">Payment Gateway:</span>
                            <span class="font-bold text-slate-800">Razorpay (Verified)</span>
                        </div>
                        <div>
                            <span class="text-slate-500 font-semibold block">Razorpay Order ID:</span>
                            <span class="font-mono text-slate-800"><%= donation.raw.razorpayOrderId || 'N/A' %></span>
                        </div>
                        <div>
                            <span class="text-slate-500 font-semibold block">Razorpay Payment ID:</span>
                            <span class="font-mono text-slate-800"><%= donation.raw.razorpayPaymentId || 'N/A' %></span>
                        </div>
                        <% if (donation.raw.message) { %>
                            <div class="md:col-span-2 pt-2 border-t border-amber-100">
                                <span class="text-slate-500 font-semibold block">Donor Message:</span>
                                <p class="text-slate-800 italic mt-0.5">"<%= donation.raw.message %>"</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <!-- Status Management Panel -->
            <div class="pt-6 border-t border-slate-200">
                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-3">Update Donation Status</h3>
                
                <form action="/admin/donations/<%= donation.modelType %>/<%= donation._id %>/status" method="POST" class="flex flex-col sm:flex-row items-center gap-3">
                    <select name="status" class="w-full sm:w-64 border border-slate-300 rounded-xl p-2.5 text-xs font-semibold bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="Pending" <%= donation.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                        <option value="Accepted" <%= donation.status === 'Accepted' ? 'selected' : '' %>>Accepted</option>
                        <option value="Pickup Scheduled" <%= donation.status === 'Pickup Scheduled' ? 'selected' : '' %>>Pickup Scheduled</option>
                        <option value="Completed" <%= donation.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                        <option value="Rejected" <%= donation.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                    </select>

                    <button type="submit" class="w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-6 py-2.5 rounded-xl shadow transition">
                        Update Status
                    </button>
                </form>
                <p class="text-[11px] text-slate-400 mt-2">Updating the status immediately persists in MongoDB Atlas and reflects on the donor's My Account page.</p>
            </div>
        </div>
    </div>
</div>

<%- include('layout_footer') %>

