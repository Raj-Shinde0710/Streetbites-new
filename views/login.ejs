<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Login - StreetBites' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="shortcut icon" href="/icon.png" type="image/x-icon">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 flex flex-col min-h-screen text-gray-800">

    <%- include('partials/navbar') %>
    <%- include('partials/alerts') %>

    <main class="flex-grow flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8">
        <div class="max-w-md w-full bg-white p-8 sm:p-10 rounded-2xl shadow-xl border border-gray-100">
            <div class="text-center mb-8">
                <span class="inline-block p-3 rounded-full bg-blue-50 text-blue-600 mb-3">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path></svg>
                </span>
                <h2 class="text-3xl font-bold text-gray-900 tracking-tight">Welcome Back</h2>
                <p class="text-sm text-gray-500 mt-2">Sign in to your StreetBites account</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded text-sm text-red-700">
                    <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST" class="space-y-5">
                <input type="hidden" name="redirect" value="<%= typeof redirectUrl !== 'undefined' ? redirectUrl : '' %>">
                <div>
                    <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Username or Email</label>
                    <input type="text" name="username" required 
                           value="<%= typeof usernameVal !== 'undefined' ? usernameVal : '' %>"
                           placeholder="Enter your username or email"
                           class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm transition">
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider">Password</label>
                    </div>
                    <input type="password" name="password" required 
                           placeholder="Enter your password"
                           class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm transition">
                </div>

                <div>
                    <button type="submit" 
                            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-md transition duration-200 transform hover:-translate-y-0.5">
                        Sign In
                    </button>
                </div>
            </form>

            <div class="mt-8 border-t border-gray-100 pt-6 text-center space-y-3">
                <p class="text-sm text-gray-500">
                    Don't have an account? 
                    <a href="/register<%= typeof redirectUrl !== 'undefined' && redirectUrl ? '?redirect=' + encodeURIComponent(redirectUrl) : '' %>" class="text-blue-600 font-semibold hover:underline">Register now</a>
                </p>
                <p class="text-xs text-gray-400">
                    Are you an administrator? 
                    <a href="/admin/login" class="text-indigo-600 font-medium hover:underline">Admin Login</a>
                </p>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

</body>
</html>

