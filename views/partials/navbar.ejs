<header class="bg-white shadow-md sticky top-0 z-40">
    <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
        <!-- Logo -->
        <a href="/" class="flex items-center space-x-4">
            <img src="/STREET-removebg-preview.png" alt="StreetBites Logo" class="h-16 w-auto object-contain">
            <div class="hidden sm:block">
                <p class="font-bold text-2xl text-blue-800 tracking-tight">StreetBites</p>
                <p class="text-xs text-gray-500 font-medium">Feeding Hope, Building Tomorrow</p>
            </div>
        </a>

        <!-- Desktop Navigation Links -->
        <div class="hidden lg:flex items-center space-x-6 text-sm font-medium">
            <a href="/" class="text-gray-700 hover:text-blue-600 transition <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'text-blue-600 font-semibold' : '' %>">Home</a>
            <a href="<%= typeof currentUser !== 'undefined' && currentUser ? '/donate' : '/login?redirect=' + encodeURIComponent('/donate') %>" class="text-gray-700 hover:text-green-600 transition <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/donate') && !currentPath.includes('clothes') && !currentPath.includes('money') ? 'text-green-600 font-semibold' : '' %>">Donate Food</a>
            <a href="<%= typeof currentUser !== 'undefined' && currentUser ? '/donate/clothes' : '/login?redirect=' + encodeURIComponent('/donate/clothes') %>" class="text-gray-700 hover:text-purple-600 transition <%= typeof currentPath !== 'undefined' && currentPath.includes('/donate/clothes') ? 'text-purple-600 font-semibold' : '' %>">Donate Clothes</a>
            <a href="<%= typeof currentUser !== 'undefined' && currentUser ? '/donate/money' : '/login?redirect=' + encodeURIComponent('/donate/money') %>" class="text-gray-700 hover:text-yellow-600 transition <%= typeof currentPath !== 'undefined' && currentPath.includes('/donate/money') ? 'text-yellow-600 font-semibold' : '' %>">Donate Money</a>

            <div class="h-5 w-px bg-gray-200"></div>

            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                <a href="/my-account" class="flex items-center space-x-1.5 text-gray-700 hover:text-blue-600 transition">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    <span>My Account</span>
                </a>

                <% if (currentUser.role === 'admin') { %>
                    <a href="/admin/dashboard" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs px-3 py-1.5 rounded-full font-semibold shadow transition">
                        Admin Panel
                    </a>
                <% } %>

                <span class="text-gray-400">|</span>

                <div class="flex items-center space-x-3">
                    <span class="text-gray-600 text-xs">Hi, <strong class="text-gray-800"><%= currentUser.fullName.split(' ')[0] %></strong></span>
                    <a href="/logout" class="text-red-500 hover:text-red-700 text-xs font-semibold hover:underline">Logout</a>
                </div>
            <% } else { %>
                <a href="/login" class="text-gray-700 hover:text-blue-600 transition">Login</a>
                <a href="/register" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg shadow-sm font-semibold transition hover:-translate-y-0.5">Register</a>
            <% } %>
        </div>

        <!-- Mobile Menu Button -->
        <div class="lg:hidden flex items-center space-x-3">
            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                <a href="/my-account" class="text-blue-600 font-semibold text-xs border border-blue-200 px-2.5 py-1 rounded">My Account</a>
            <% } %>
            <button id="mobile-menu-btn" aria-label="Toggle menu" class="text-gray-600 hover:text-blue-600 p-2 focus:outline-none">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
                </svg>
            </button>
        </div>
    </nav>

    <!-- Mobile Dropdown Menu -->
    <div id="mobile-dropdown" class="lg:hidden hidden bg-white border-t border-gray-100 px-6 py-4 space-y-3 shadow-lg">
        <a href="/" class="block py-1.5 text-gray-700 hover:text-blue-600 font-medium">Home</a>
        <a href="<%= typeof currentUser !== 'undefined' && currentUser ? '/donate' : '/login?redirect=' + encodeURIComponent('/donate') %>" class="block py-1.5 text-green-700 hover:text-green-800 font-medium">Donate Food</a>
        <a href="<%= typeof currentUser !== 'undefined' && currentUser ? '/donate/clothes' : '/login?redirect=' + encodeURIComponent('/donate/clothes') %>" class="block py-1.5 text-purple-700 hover:text-purple-800 font-medium">Donate Clothes</a>
        <a href="<%= typeof currentUser !== 'undefined' && currentUser ? '/donate/money' : '/login?redirect=' + encodeURIComponent('/donate/money') %>" class="block py-1.5 text-yellow-700 hover:text-yellow-800 font-medium">Donate Money</a>

        <div class="border-t border-gray-100 pt-3">
            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                <div class="mb-2 text-xs text-gray-500">Logged in as <strong><%= currentUser.fullName %></strong></div>
                <a href="/my-account" class="block py-1.5 text-blue-600 font-medium">My Account</a>
                <% if (currentUser.role === 'admin') { %>
                    <a href="/admin/dashboard" class="block py-1.5 text-indigo-600 font-medium">Admin Dashboard</a>
                <% } %>
                <a href="/logout" class="block py-1.5 text-red-600 font-medium">Logout</a>
            <% } else { %>
                <div class="flex space-x-3 pt-2">
                    <a href="/login" class="flex-1 text-center py-2 border border-gray-300 text-gray-700 rounded-lg font-medium">Login</a>
                    <a href="/register" class="flex-1 text-center py-2 bg-blue-600 text-white rounded-lg font-medium shadow">Register</a>
                </div>
            <% } %>
        </div>
    </div>
</header>

<script>
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileDropdown = document.getElementById('mobile-dropdown');
    if (mobileBtn && mobileDropdown) {
        mobileBtn.addEventListener('click', () => {
            mobileDropdown.classList.toggle('hidden');
        });
    }
</script>

