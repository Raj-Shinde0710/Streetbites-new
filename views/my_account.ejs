<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'My Account - StreetBites' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="shortcut icon" href="/icon.png" type="image/x-icon">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 flex flex-col min-h-screen text-gray-800">

    <%- include('partials/navbar') %>
    <%- include('partials/alerts') %>

    <main class="flex-grow container mx-auto px-6 py-10">
        <!-- Top Profile Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 mb-8">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center space-y-4 md:space-y-0">
                <div class="flex items-center space-x-5">
                    <div class="h-16 w-16 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-2xl shadow-inner">
                        <%= user.fullName.charAt(0).toUpperCase() %>
                    </div>
                    <div>
                        <div class="flex items-center space-x-2">
                            <h1 class="text-2xl font-bold text-gray-900"><%= user.fullName %></h1>
                            <% if (user.role === 'admin') { %>
                                <span class="bg-indigo-100 text-indigo-700 text-xs px-2.5 py-0.5 rounded-full font-semibold">Administrator</span>
                            <% } else { %>
                                <span class="bg-green-100 text-green-700 text-xs px-2.5 py-0.5 rounded-full font-semibold">Donor</span>
                            <% } %>
                        </div>
                        <p class="text-sm text-gray-500">@<%= user.username %> &bull; <%= user.email %></p>
                    </div>
                </div>

                <div class="flex items-center space-x-3">
                    <a href="/donate" class="bg-green-600 hover:bg-green-700 text-white text-sm px-4 py-2 rounded-lg font-semibold shadow transition">
                        + Donate Food
                    </a>
                    <a href="/donate/clothes" class="bg-purple-600 hover:bg-purple-700 text-white text-sm px-4 py-2 rounded-lg font-semibold shadow transition">
                        + Donate Clothes
                    </a>
                    <a href="/donate/money" class="bg-yellow-500 hover:bg-yellow-600 text-white text-sm px-4 py-2 rounded-lg font-semibold shadow transition">
                        + Donate Money
                    </a>
                </div>
            </div>

            <!-- Profile Meta Info -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8 pt-6 border-t border-gray-100 text-sm">
                <div>
                    <span class="text-xs text-gray-400 font-semibold uppercase">Mobile Number</span>
                    <p class="font-medium text-gray-800"><%= user.mobile || 'Not provided' %></p>
                </div>
                <div>
                    <span class="text-xs text-gray-400 font-semibold uppercase">Account Role</span>
                    <p class="font-medium text-gray-800 capitalize"><%= user.role %></p>
                </div>
                <div>
                    <span class="text-xs text-gray-400 font-semibold uppercase">Member Since</span>
                    <p class="font-medium text-gray-800"><%= new Date(user.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                </div>
            </div>
        </div>

        <!-- Donations History Section -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-xl font-bold text-gray-900">Your Donation History</h2>
                    <p class="text-xs text-gray-500">Track all your food, clothing, and monetary contributions</p>
                </div>
                <span class="text-xs font-semibold bg-gray-100 text-gray-600 px-3 py-1 rounded-full">
                    <%= donations.length %> Total Contributions
                </span>
            </div>

            <% if (donations.length === 0) { %>
                <div class="text-center py-12 bg-gray-50 rounded-xl border border-dashed border-gray-200">
                    <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path></svg>
                    <p class="text-gray-600 font-medium">No donations recorded yet</p>
                    <p class="text-xs text-gray-400 mt-1 max-w-sm mx-auto">Make your first food, clothes, or monetary donation to see your impact here.</p>
                    <div class="mt-4 flex justify-center space-x-3">
                        <a href="/donate" class="bg-blue-600 text-white text-xs px-4 py-2 rounded-lg font-semibold shadow hover:bg-blue-700 transition">Start Donating</a>
                    </div>
                </div>
            <% } else { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-gray-50 text-gray-500 text-xs uppercase font-semibold border-b">
                            <tr>
                                <th class="py-3 px-4">Category</th>
                                <th class="py-3 px-4">Summary / Items</th>
                                <th class="py-3 px-4">Date</th>
                                <th class="py-3 px-4">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <% donations.forEach(item => { %>
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="py-3.5 px-4">
                                        <% if (item.category === 'food') { %>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                                                🍲 Food
                                            </span>
                                        <% } else if (item.category === 'clothes') { %>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-800">
                                                👕 Clothes
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800">
                                                💰 Money
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="py-3.5 px-4 font-medium text-gray-800">
                                        <%= item.summary %>
                                    </td>
                                    <td class="py-3.5 px-4 text-xs text-gray-500">
                                        <%= new Date(item.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <% if (item.status === 'Completed') { %>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                Completed
                                            </span>
                                        <% } else if (item.status === 'Accepted' || item.status === 'Pickup Scheduled') { %>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                <%= item.status %>
                                            </span>
                                        <% } else if (item.status === 'Rejected') { %>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                                Rejected
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                Pending Review
                                            </span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>

</body>
</html>

