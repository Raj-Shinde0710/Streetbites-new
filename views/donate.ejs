<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Donate Food - StreetBites</title>

<script src="https://cdn.tailwindcss.com"></script>

<link rel="stylesheet" href="/style.css">
<link rel="shortcut icon" href="/icon.png" type="image/x-icon">

</head>

<body class="bg-gray-50">

<header class="bg-white shadow-md">
<nav class="container mx-auto px-6 py-4 flex justify-between items-center">

<a href="/" class="flex items-center space-x-4">
<img src="/STREET-removebg-preview.png" class="h-20">
<div>
<p class="font-bold text-3xl text-blue-800">StreetBites</p>
<p class="text-gray-600">Feeding Hope, Building Tomorrow</p>
</div>
</a>

</nav>
</header>



<main class="container mx-auto px-6 py-12">

<div class="max-w-3xl mx-auto bg-white p-10 rounded-xl shadow-lg">

<h1 class="text-3xl font-bold mb-6">

<% if(type==="organization"){ %>
Organization Donation
<% } else { %>
Individual Donation
<% } %>

</h1>


<form action="/donate/<%= type %>" method="POST" class="space-y-6">


<% if(type==="organization"){ %>

<div>
<label>Organization Name</label>
<input type="text" name="organizationName" required class="w-full border p-2 rounded">
</div>

<% } else { %>

<div>
<label>Full Name</label>
<input type="text" name="fullName" required class="w-full border p-2 rounded">
</div>

<% } %>


<div>
<label>Email</label>
<input type="email" name="email" required class="w-full border p-2 rounded">
</div>


<div>
<label>Mobile</label>
<input type="text" name="mobile" required class="w-full border p-2 rounded">
</div>


<div>
<label>Pickup Address</label>
<textarea name="address" rows="3" required class="w-full border p-2 rounded"></textarea>
</div>


<div>
<label>Pickup Method</label>

<select name="pickupMethod" class="w-full border p-2 rounded">

<option value="volunteer">
Pickup by Volunteer
</option>

<option value="self">
I will Deliver Myself
</option>

</select>

</div>


<div>
<label>Date of Cooking</label>
<input type="date" name="cookingDate" required class="w-full border p-2 rounded">
</div>


<div>
<label>Use Before Date</label>
<input type="date" name="useBeforeDate" required class="w-full border p-2 rounded">
</div>



<h2 class="text-xl font-semibold">Food Items</h2>

<table class="w-full border" id="foodTable">

<thead class="bg-gray-200">

<tr>
<th class="border p-2">Food Name</th>
<th class="border p-2">Quantity</th>
<th class="border p-2">Storage Instructions</th>
<th class="border p-2">Action</th>
</tr>

</thead>

<tbody>

<tr>

<td class="border p-2">
<input type="text" name="foodName[]" required class="w-full border rounded p-2">
</td>

<td class="border p-2">
<input type="text" name="quantity[]" required class="w-full border rounded p-2">
</td>

<td class="border p-2">
<input type="text" name="storage[]" placeholder="Refrigerate / Room Temp" class="w-full border rounded p-2">
</td>

<td class="border p-2 text-center">
<button type="button" onclick="removeRow(this)" class="text-red-500">Remove</button>
</td>

</tr>

</tbody>

</table>


<button type="button" onclick="addRow()" class="bg-green-600 text-white px-4 py-2 rounded mt-3">

Add Another Food

</button>


<button type="submit" class="w-full bg-blue-600 text-white py-3 rounded mt-6">

Submit Donation

</button>

</form>

</div>

</main>



<script>

function addRow(){

const table=document.getElementById("foodTable").getElementsByTagName("tbody")[0];

const row=table.insertRow();

row.innerHTML=`

<td class="border p-2">
<input type="text" name="foodName[]" required class="w-full border rounded p-2">
</td>

<td class="border p-2">
<input type="text" name="quantity[]" required class="w-full border rounded p-2">
</td>

<td class="border p-2">
<input type="text" name="storage[]" placeholder="Refrigerate / Room Temp" class="w-full border rounded p-2">
</td>

<td class="border p-2 text-center">
<button type="button" onclick="removeRow(this)" class="text-red-500">Remove</button>
</td>

`;

}


function removeRow(btn){

const row=btn.parentNode.parentNode;
row.parentNode.removeChild(row);

}

</script>

</body>
</html>