# MongoDB Atlas Connection String (Required)
# Important: Whitelist all IPs (0.0.0.0/0) in MongoDB Atlas Network Access for Vercel deployment
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/streetbitesDB?retryWrites=true&w=majority

# Session Security (Required)
SESSION_SECRET=your_long_session_secret_key_here

# Initial Administrator Credentials (Required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecureAdminPassword123!
# Optional: supply an existing bcrypt hash instead of plain password
# ADMIN_PASSWORD_HASH=$2b$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=admin@streetbites.org

# Razorpay Payment Gateway (Required for Monetary Donations)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Node Environment (Set to 'production' on Vercel)
NODE_ENV=production
